# Copy these into Vercel: Project → Settings → Environment Variables
# Do not commit real values.

# Supabase → Project Settings → Database → Connection string → URI
# Use the Transaction pooler (port 6543) for Vercel.
# If the database password has symbols, URL-encode them in this string.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# First admin user. Created once, when that email does not exist yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_USERNAME=admin

# Supabase → Project Settings → API
# Create a public Storage bucket named "uploads" before uploading images.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=uploads

# Optional email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM_EMAIL=your-email@example.com
SMTP_FROM_NAME=Excellence Academy
ADMIN_EMAILS=admin@example.com
