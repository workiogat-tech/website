{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 30
    },
    "api/health.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 10
    },
    "api/page.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 30
    },
    "api/auth/*.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 30
    },
    "api/content/*.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 30
    },
    "api/forms/*.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 30
    },
    "api/media/*.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 30
    },
    "api/public/*.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/css/(.*)",
      "dest": "/css/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/js/(.*)",
      "dest": "/js/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/uploads/$1",
      "headers": {
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "src": "/(.*\\.(css|js|json|html|ico|png|jpg|jpeg|gif|svg|webp|woff|woff2|ttf|eot|otf))",
      "dest": "/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/([^./]+)",
      "dest": "/$1.html"
    }
  ]
}
