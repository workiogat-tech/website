{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 30
    },
    "api/render.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 30,
      "includeFiles": "{*.html,render.php,config/**,includes/**,admin-tabs/**}"
    }
  },
  "routes": [
    {
      "src": "^/api/?$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/api/(.+)$",
      "dest": "/api/index.php?__path=$1"
    },
    {
      "src": "/",
      "dest": "/api/render.php?page=index.html"
    },
    {
      "src": "/css/(.*)",
      "dest": "/css/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/js/(.*)",
      "dest": "/js/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/uploads/$1",
      "headers": {
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "src": "/admin-tabs/(.*)",
      "dest": "/admin-tabs/$1"
    },
    {
      "src": "/(.*\\.html)",
      "dest": "/api/render.php?page=$1"
    },
    {
      "src": "/(.*\\.(css|js|json|ico|png|jpg|jpeg|gif|svg|webp|woff|woff2|ttf|eot|otf))",
      "dest": "/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/([^./]+)",
      "dest": "/api/render.php?page=$1.html"
    }
  ]
}
